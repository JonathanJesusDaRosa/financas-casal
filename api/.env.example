# Copie este arquivo para ".env" e preencha os valores.
# O .env fica fora do Git; este exemplo pode ir para o GitHub.

PORT=3333
WEB_URL=http://localhost:5173

# Endereços do banco no Neon (painel do Neon > Connect)
# DATABASE_URL = conexão "pooled" (tem "-pooler" no endereço), usada pelo app
# DIRECT_URL   = mesma conexão sem "-pooler", usada pelas migrações
DATABASE_URL="postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=verify-full"
DIRECT_URL="postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=verify-full"

# Chave que assina os tokens de login. Gere uma com:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-por-uma-chave-aleatoria"

# Banco de PRODUÇÃO (branch principal do Neon). As variáveis acima apontam para a branch "dev".
# PRODUCAO_DIRECT_URL   = usada só pelo comando "npm run db:migrar-producao"
# PRODUCAO_DATABASE_URL = usada só pela trava do "npm test" (recusa rodar se DATABASE_URL for igual a ela)
PRODUCAO_DIRECT_URL="postgresql://usuario:senha@ep-yyyy.sa-east-1.aws.neon.tech/neondb?sslmode=verify-full"
PRODUCAO_DATABASE_URL="postgresql://usuario:senha@ep-yyyy-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=verify-full"
